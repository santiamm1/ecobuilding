# URLs limpias: /blog/nota sirve /blog/nota.html
Options -MultiViews
RewriteEngine On

# /index.html y /blog/index.html -> / y /blog/ (301)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /pagina.html -> /pagina (301): conserva el SEO de los enlaces viejos
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /pagina -> pagina.html (interno, el usuario no lo ve)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]
